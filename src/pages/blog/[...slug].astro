---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const base = `${import.meta.env.BASE_URL}/`;
const directoryPosts = post.id === "hello-world"
  ? (await getCollection("blog"))
      .filter((candidate) => candidate.id !== post.id)
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  : [];
---

<BaseLayout title={`${post.data.title} | 我的博客`} description={post.data.description}>
  <article>
    <a class="back" href={base}>← 返回文章列表</a>
    <header class="post-header" data-reveal>
      <time datetime={post.data.pubDate.toISOString()}>
        {post.data.pubDate.toLocaleDateString("zh-CN")}
      </time>
      <h1>{post.data.title}</h1>
      {post.data.tags.length > 0 && (
        <ul class="tags" aria-label="文章标签">
          {post.data.tags.map((tag) => <li>{tag}</li>)}
        </ul>
      )}
      <hr />
    </header>
    <div class="prose" data-reveal style="--delay: 100ms"><Content /></div>
    {post.id === "hello-world" && (
      <section class="blog-directory" aria-labelledby="directory-title">
        <p class="directory-label">自动更新</p>
        <h2 id="directory-title">文章目录</h2>
        <ul>
          {directoryPosts.map((entry) => (
            <li>
              <a href={`${base}blog/${entry.id}/`}>{entry.data.title}</a>
              <p>{entry.data.description}</p>
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>
</BaseLayout>

<script>
  const postHeader = document.querySelector<HTMLElement>(".post-header");
  let previousScrollY = window.scrollY;

  window.addEventListener("scroll", () => {
    const currentScrollY = window.scrollY;
    const isReadingDown = currentScrollY > 48 && currentScrollY > previousScrollY;
    postHeader?.classList.toggle("is-hidden", isReadingDown);
    previousScrollY = currentScrollY;
  }, { passive: true });
</script>

<style>
  .back { display: inline-flex; align-items: center; min-height: 44px; margin-bottom: 1.25rem; color: var(--ink-muted); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .78rem; letter-spacing: .08em; text-decoration: none; transition: color .2s ease, transform .2s ease; }
  .back:hover { color: var(--vermilion); transform: translateX(-3px); }
  .post-header { padding: .25rem 0; text-align: center; transition: opacity .18s ease, transform .18s ease; }
  .post-header.is-hidden { opacity: 0; pointer-events: none; transform: translateY(-.75rem); }
  h1 { max-width: 900px; margin: .45rem auto .8rem; color: #28241f; font-size: clamp(1.9rem, 4vw, 3rem); font-weight: 600; letter-spacing: -.04em; line-height: 1.25; }
  time { color: #887c6f; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .75rem; letter-spacing: .06em; }
  article :global(a) { color: #a8402a; }
  .tags { display: flex; flex-wrap: wrap; justify-content: center; gap: .5rem; padding: 0; list-style: none; }
  .tags li { color: #a8402a; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .68rem; letter-spacing: .06em; }
  hr { max-width: 86px; margin: 1.7rem auto 0; border: 0; border-top: 1px solid #b34b35; }
  .prose { max-width: var(--measure); margin: 0 auto; color: #494139; font-size: 1.08rem; }
  .prose :global(h2) { margin-top: 2.6em; color: #28241f; font-size: 1.55em; font-weight: 600; }
  .prose :global(h3) { margin-top: 2em; color: #28241f; }
  .prose :global(li::marker) { color: #b34b35; }
  .prose :global(pre) { overflow-x: auto; padding: 1rem 1.2rem; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); background: rgba(91, 67, 40, .06); }
  .prose :global(blockquote) { margin: 2rem 0; padding: .3rem 0 .3rem 1.2rem; color: var(--ink-soft); border-left: 1px solid var(--vermilion); }
  .prose :global(a) { text-underline-offset: .18em; }
  .prose :global(.project-shot) { margin: 2rem 0; }
  .prose :global(.project-shot img) { display: block; width: 100%; max-width: 100%; height: auto; border: 1px solid var(--line); border-radius: .35rem; box-shadow: 0 14px 32px rgba(65, 50, 34, .1); }
  .prose :global(.project-shot figcaption) { margin-top: .7rem; color: var(--ink-muted); font-size: .84em; line-height: 1.55; }
  .prose :global(.sports-gallery) { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin: 2rem 0; }
  .prose :global(.sports-gallery figure) { margin: 0; }
  .prose :global(.sports-gallery .wide) { grid-column: 1 / -1; }
  .prose :global(.sports-gallery img) { display: block; width: 100%; height: 100%; min-height: 15rem; object-fit: cover; border-radius: .35rem; }
  .prose :global(.sports-gallery .wide img) { max-height: 26rem; }
  .prose :global(.sports-gallery figcaption) { margin-top: .55rem; color: var(--ink-muted); font-size: .84em; line-height: 1.55; }
  .prose :global(.intro-video) { display: block; margin: 1.5rem 0; border-radius: 14px; box-shadow: 0 18px 45px rgba(20, 28, 46, 0.2); background: #111827; outline: none; }
  .prose :global(.intro-video:focus-visible) { outline: 2px solid var(--vermilion); outline-offset: 4px; }
  .blog-directory { max-width: var(--measure); margin: 3rem auto 0; padding-top: 1.8rem; border-top: 1px solid var(--line); }
  .directory-label { margin: 0 0 .25rem; color: var(--vermilion); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .7rem; letter-spacing: .1em; }
  .blog-directory h2 { margin: 0 0 1rem; color: #28241f; font-size: 1.45rem; }
  .blog-directory ul { margin: 0; padding: 0; list-style: none; }
  .blog-directory li { padding: 1rem 0; border-top: 1px solid rgba(65, 50, 34, .14); }
  .blog-directory li:last-child { border-bottom: 1px solid rgba(65, 50, 34, .14); }
  .blog-directory a { color: #a8402a; font-weight: 600; text-underline-offset: .18em; }
  .blog-directory p { margin: .25rem 0 0; color: var(--ink-soft); font-size: .94rem; }
  @media (max-width: 620px) { .prose :global(.sports-gallery) { grid-template-columns: 1fr; } .prose :global(.sports-gallery .wide) { grid-column: auto; } .prose :global(.sports-gallery img), .prose :global(.sports-gallery .wide img) { min-height: 0; max-height: none; height: auto; } }
</style>
