---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const pinnedPostId = "hello-world";
const posts = (await getCollection("blog")).sort((a, b) => {
  if (a.id === pinnedPostId) return -1;
  if (b.id === pinnedPostId) return 1;
  return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
});
const recentPosts = posts.slice(0, 3);
const coverLabels = ["构建", "复盘", "笔记"];
const base = `${import.meta.env.BASE_URL}/`;
---

<BaseLayout title="我的博客">
  <section class="hero" aria-labelledby="page-title">
    <span class="hero-watermark" aria-hidden="true">学</span>
    <p class="eyebrow" data-reveal><span></span> 学习记录 · 2026</p>
    <h1 id="page-title" data-reveal style="--delay: 80ms">把每一次理解，<br /><em>写在边页。</em></h1>
    <p class="intro" data-reveal style="--delay: 150ms">从搭建第一个 Astro 博客开始，慢慢记录 AI 开发中的工具、实践和新的理解。</p>
    <a class="archive-link" data-reveal style="--delay: 220ms" href="#articles">翻到最近的记录 <span aria-hidden="true">↓</span></a>
    <ul class="facts" data-reveal style="--delay: 290ms" aria-label="博客统计">
      <li><b>{posts.length}</b> 篇记录</li>
      <li><b>Astro</b> 构建</li>
      <li><b>持续</b> 学习中</li>
    </ul>
  </section>

  <section id="articles" class="content-layout" aria-labelledby="articles-title">
    <div class="post-list">
      <div class="section-heading" data-reveal>
        <p class="section-label">近稿</p>
        <h2 id="articles-title">最近写下的东西</h2>
      </div>

      {recentPosts.map((post, index) => (
        <article class:list={["post-card", { latest: index === 0 }]} data-reveal style={`--delay: ${index * 110}ms`}>
          <div class="post-cover" aria-hidden="true"><span>{coverLabels[index]}</span><b>{String(index + 1).padStart(2, "0")}</b></div>
          <div class="post-body">
            <div class="post-meta">
              <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString("zh-CN")}</time>
              {index === 0 && <span>最新</span>}
            </div>
            <h3><a href={`${base}blog/${post.id}/`}>{post.data.title}</a></h3>
            <p>{post.data.description}</p>
            {post.data.tags.length > 0 && <ul class="tags" aria-label="文章标签">{post.data.tags.map((tag) => <li>{tag}</li>)}</ul>}
          </div>
          <a class="read-more" aria-label={`阅读：${post.data.title}`} href={`${base}blog/${post.id}/`}>阅读更多 <span aria-hidden="true">→</span></a>
        </article>
      ))}
    </div>

    <aside class="sidebar" data-reveal style="--delay: 160ms" aria-labelledby="author-title">
      <img class="author-avatar" src={`${base}images/about/avatar-intro-wink.png`} alt="徐恺晨的虚拟头像" width="160" height="160" loading="lazy" />
      <p class="section-label">关于作者</p>
      <h2 id="author-title">徐恺晨</h2>
      <p>信息安全专业学生，也是持续学习 AI、智能体与前端开发的技术探索者。</p>
      <nav class="author-links" aria-label="作者链接">
        <a href={`${base}blog/about-me/`}>了解更多 <span aria-hidden="true">↗</span></a>
        <a href="https://github.com/Allen-David" target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
      </nav>
      <p class="sidebar-note">不只看懂文档，也把知识写成可运行、可验证的结果。</p>
    </aside>
  </section>
</BaseLayout>

<style>
  /* 少量设计变量复用间距与颜色：Grid 负责两栏，Flex/Grid 的 gap 取代子项 margin。 */
  .hero, .content-layout { --s1: .5rem; --s2: 1rem; --s3: 1.5rem; --s4: 2.5rem; --accent: var(--vermilion); }
  .hero { position: relative; padding: clamp(5rem, 12vw, 8rem) 0 clamp(4.5rem, 10vw, 7rem); overflow: hidden; }
  .hero-watermark { position: absolute; z-index: -1; top: 1rem; right: 4%; color: rgba(70, 56, 39, .035); font-size: clamp(18rem, 38vw, 34rem); line-height: .8; user-select: none; }
  .eyebrow, .section-label, .post-meta, .tags, .sidebar-note { color: var(--ink-muted); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .74rem; letter-spacing: .1em; }
  .eyebrow { display: flex; align-items: center; gap: var(--s1); color: var(--accent); }
  .eyebrow span { width: 2rem; height: 1px; background: currentColor; }
  h1 { max-width: 1000px; margin: 1.3rem 0 1.7rem; color: var(--ink); font-size: clamp(3.1rem, 8.2vw, 7rem); font-weight: 600; letter-spacing: -.08em; line-height: 1.02; }
  h1 em { color: var(--accent); font-weight: 500; }
  .intro { max-width: 37rem; color: var(--ink-soft); font-size: 1.12rem; }
  .archive-link, .author-links a { display: inline-flex; align-items: center; gap: .65rem; color: var(--ink); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .78rem; letter-spacing: .06em; text-decoration: none; }
  .archive-link { margin-top: 1.4rem; padding-bottom: .18rem; border-bottom: 1px solid currentColor; }
  .archive-link:hover, .author-links a:hover { color: var(--accent); }
  .facts, .tags { display: flex; flex-wrap: wrap; gap: var(--s2); margin: 2.8rem 0 0; padding: 0; list-style: none; }
  .facts { color: var(--ink-muted); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .78rem; letter-spacing: .07em; }
  .facts b { color: var(--ink-soft); font-weight: 600; }
  .content-layout { display: grid; grid-template-columns: minmax(0, 1fr) 15rem; gap: clamp(2.5rem, 6vw, 5rem); scroll-margin-top: 6rem; }
  .section-heading { display: flex; align-items: baseline; gap: var(--s3); padding-bottom: 1.25rem; border-bottom: 1px solid var(--line); }
  h2 { margin: 0; color: var(--ink); font-size: 1.05rem; font-weight: 600; letter-spacing: .02em; }
  .post-card { display: grid; grid-template-columns: 7.5rem minmax(0, 1fr) auto; gap: var(--s3); align-items: center; padding: var(--s4) 0; border-bottom: 1px solid var(--line); }
  .post-card.latest { background: linear-gradient(90deg, rgba(179, 75, 53, .07), transparent 72%); }
  .post-cover { display: grid; aspect-ratio: 1; place-items: center; align-content: center; gap: .1rem; color: #7d4538; background: #e8ded0; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
  .post-cover span { font-size: .68rem; letter-spacing: .08em; }
  .post-cover b { font-size: 1.6rem; font-weight: 500; }
  .post-body { min-width: 0; }
  .post-meta { display: flex; gap: var(--s2); margin-bottom: .35rem; }
  .post-meta span { color: var(--accent); }
  .post-card h3 { margin: 0 0 .35rem; color: var(--ink); font-size: clamp(1.4rem, 3vw, 2rem); font-weight: 600; letter-spacing: -.04em; line-height: 1.35; }
  .post-card h3 a { text-decoration-thickness: 1px; text-decoration-color: transparent; text-underline-offset: .2em; transition: color .2s, text-decoration-color .2s; }
  .post-card h3 a:hover { color: var(--accent); text-decoration-color: currentColor; }
  .post-card p, .sidebar > p { margin: 0; color: var(--ink-soft); }
  .tags { gap: var(--s1); margin-top: .8rem; color: #9d5a49; font-size: .68rem; letter-spacing: .04em; }
  .read-more { display: inline-flex; align-items: center; gap: .45rem; min-height: 44px; color: var(--ink-muted); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .72rem; letter-spacing: .06em; text-decoration: none; white-space: nowrap; }
  .read-more:hover { color: var(--accent); }
  .sidebar { align-self: start; display: grid; gap: var(--s2); padding-top: .2rem; }
  .author-avatar { width: 5rem; aspect-ratio: 1; border-radius: 50%; object-fit: cover; background: #e8ded0; }
  .sidebar h2 { font-size: 1.35rem; }
  .sidebar > p { line-height: 1.75; }
  .author-links { display: grid; gap: .25rem; padding: var(--s2) 0; border-block: 1px solid var(--line); }
  .author-links a { justify-content: space-between; min-height: 36px; }
  .sidebar-note { line-height: 1.65; }
  @media (max-width: 780px) { .content-layout { grid-template-columns: 1fr; } .sidebar { grid-template-columns: 5rem minmax(0, 1fr); column-gap: var(--s3); padding-top: 1rem; } .author-avatar { grid-row: span 4; } .author-links { grid-column: 1 / -1; } .sidebar-note { grid-column: 2; } }
  @media (max-width: 600px) { .hero { padding: 5rem 0 4rem; } .facts { gap: .8rem; } .post-card { grid-template-columns: 4.75rem minmax(0, 1fr); gap: var(--s2); padding: 1.8rem 0; } .post-cover { grid-row: span 2; } .read-more { grid-column: 2; } .sidebar { grid-template-columns: 1fr; } .author-avatar, .sidebar-note { grid-row: auto; grid-column: auto; } }
</style>
