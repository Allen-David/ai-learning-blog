---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout title="我的博客">
  <section class="hero" aria-labelledby="page-title">
    <p class="eyebrow"><span></span> 正在学习与持续构建</p>
    <h1 id="page-title">用作品记录<br /><strong>AI 开发</strong>的学习之旅</h1>
    <p class="intro">从一个能运行的静态博客开始，记录工具、实践和每一次新的理解。</p>
    <a class="cta" href="#articles">阅读最新文章 <span aria-hidden="true">↓</span></a>
  </section>

  <section id="articles" aria-labelledby="articles-title">
    <p class="section-label">WRITING / 学习记录</p>
    <h2 id="articles-title">最新文章</h2>
    {posts.map((post) => (
      <article class="post-card">
        <time datetime={post.data.pubDate.toISOString()}>
          {post.data.pubDate.toLocaleDateString("zh-CN")}
        </time>
        <h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
        <p>{post.data.description}</p>
        {post.data.tags.length > 0 && (
          <ul class="tags" aria-label="文章标签">
            {post.data.tags.map((tag) => <li>{tag}</li>)}
          </ul>
        )}
        <a class="read-more" href={`/blog/${post.id}/`}>阅读文章 <span aria-hidden="true">→</span></a>
      </article>
    ))}
  </section>
</BaseLayout>

<style>
  .hero { max-width: 790px; padding: 4rem 0 6rem; }
  .eyebrow, .section-label { color: #a5b4fc; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .78rem; letter-spacing: .12em; }
  .eyebrow { display: flex; align-items: center; gap: .55rem; }
  .eyebrow span { width: .55rem; height: .55rem; border-radius: 50%; background: #22d3ee; box-shadow: 0 0 18px #22d3ee; }
  h1 { margin: 1rem 0 1.5rem; color: #f8fafc; font-size: clamp(2.8rem, 8vw, 5.7rem); letter-spacing: -.07em; line-height: 1.03; }
  h1 strong { background: linear-gradient(135deg, #a5b4fc, #22d3ee); background-clip: text; -webkit-background-clip: text; color: transparent; font-weight: 800; }
  .intro { max-width: 600px; color: #94a3b8; font-size: 1.12rem; }
  .cta { display: inline-flex; gap: .65rem; margin-top: 1.25rem; padding: .68rem 1rem; border: 1px solid rgba(103, 232, 249, .22); border-radius: .6rem; color: #cffafe; background: rgba(6, 182, 212, .08); text-decoration: none; transition: transform .2s, background .2s; }
  .cta:hover { background: rgba(6, 182, 212, .16); transform: translateY(-2px); }
  #articles { scroll-margin-top: 6rem; }
  h2 { margin: .2rem 0 1.5rem; color: #f8fafc; font-size: clamp(1.65rem, 4vw, 2.3rem); letter-spacing: -.04em; }
  .post-card { position: relative; margin-bottom: 1rem; padding: 1.65rem; overflow: hidden; border: 1px solid rgba(255, 255, 255, .08); border-radius: 1rem; background: rgba(18, 18, 26, .78); box-shadow: 0 14px 38px rgba(0, 0, 0, .16); transition: border-color .2s, transform .2s; }
  .post-card:hover { border-color: rgba(103, 232, 249, .32); transform: translateY(-3px); }
  .post-card::before { position: absolute; top: 0; left: 0; width: 4px; height: 100%; background: linear-gradient(#818cf8, #22d3ee); content: ""; }
  .post-card h2 { margin: .25rem 0 .45rem; font-size: 1.32rem; }
  .post-card h2 a { color: #f1f5f9; text-decoration: none; }
  .post-card h2 a:hover { color: #a5f3fc; }
  .post-card p { max-width: 720px; margin: 0 0 1rem; color: #94a3b8; }
  time { color: #94a3b8; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .78rem; }
  .tags { display: flex; flex-wrap: wrap; gap: .5rem; padding: 0; list-style: none; }
  .tags li { padding: .14rem .58rem; color: #c4b5fd; border: 1px solid rgba(129, 140, 248, .22); border-radius: 999px; background: rgba(99, 102, 241, .1); font-size: .76rem; }
  .read-more { color: #67e8f9; font-size: .9rem; font-weight: 650; text-decoration: none; }
  .read-more span { display: inline-block; transition: transform .2s; }
  .read-more:hover span { transform: translateX(4px); }
  @media (max-width: 640px) { .hero { padding: 2.5rem 0 4rem; } .post-card { padding: 1.35rem; } }
</style>
