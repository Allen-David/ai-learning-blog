---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "一个使用 Astro 构建的静态博客" } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <div class="scroll-progress" aria-hidden="true"><span></span></div>
    <header>
      <nav aria-label="主导航">
        <a class="brand" href="/"><span class="brand-mark">记</span><span>AI 学习手记</span></a>
        <a class="nav-link" href="/#articles">文章</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer>记录学习的边页 · 2026</footer>
    <script>
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const progress = document.querySelector<HTMLElement>(".scroll-progress span");

      if (!reducedMotion && progress) {
        const updateProgress = () => {
          const available = document.documentElement.scrollHeight - window.innerHeight;
          progress.style.transform = `scaleX(${available > 0 ? window.scrollY / available : 0})`;
        };
        updateProgress();
        window.addEventListener("scroll", updateProgress, { passive: true });
      }

      if (!reducedMotion && "IntersectionObserver" in window) {
        document.documentElement.classList.add("motion-ready");
        const observer = new IntersectionObserver(
          (entries) => entries.forEach((entry) => entry.isIntersecting && entry.target.classList.add("is-visible")),
          { threshold: 0.12 },
        );
        document.querySelectorAll("[data-reveal]").forEach((element) => observer.observe(element));
      }
    </script>
  </body>
</html>

<style is:global>
  :root { color: #28241f; background: #f5f1e9; font-family: "Noto Serif SC", "Source Han Serif SC", "Songti SC", STSong, serif; }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { min-width: 320px; margin: 0; line-height: 1.8; background-color: #f5f1e9; background-image: radial-gradient(rgba(77, 60, 40, .055) .6px, transparent .7px), radial-gradient(rgba(77, 60, 40, .035) .6px, transparent .7px); background-position: 0 0, 7px 9px; background-size: 15px 15px; }
  .scroll-progress { position: fixed; z-index: 20; top: 0; left: 0; width: 100%; height: 2px; background: rgba(78, 56, 35, .08); }
  .scroll-progress span { display: block; width: 100%; height: 100%; background: #b34b35; transform: scaleX(0); transform-origin: left; }
  header { position: sticky; z-index: 10; top: 0; background: rgba(245, 241, 233, .88); backdrop-filter: blur(14px); }
  nav, main, footer { width: min(1200px, calc(100% - 2rem)); margin: 0 auto; }
  nav { min-height: 82px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid rgba(65, 50, 34, .14); }
  a { color: inherit; }
  .brand { display: inline-flex; align-items: center; gap: .7rem; color: #28241f; font-size: 1.05rem; font-weight: 700; letter-spacing: .02em; text-decoration: none; }
  .brand-mark { display: grid; width: 1.8rem; height: 1.8rem; place-items: center; border-radius: .34rem; color: #fffaf2; background: #b34b35; font-size: .85rem; font-family: ui-sans-serif, system-ui, sans-serif; box-shadow: 0 4px 10px rgba(151, 59, 38, .18); }
  .nav-link { position: relative; color: #5b5146; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .78rem; letter-spacing: .15em; text-decoration: none; }
  .nav-link::after { position: absolute; bottom: -.7rem; left: 50%; width: 4px; height: 4px; border-radius: 50%; background: #b34b35; content: ""; transform: translateX(-50%) scale(0); transition: transform .2s; }
  .nav-link:hover::after { transform: translateX(-50%) scale(1); }
  main { padding: 2.5rem 0 5rem; }
  footer { padding: 2rem 0 3rem; color: #817568; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .72rem; letter-spacing: .1em; border-top: 1px solid rgba(65, 50, 34, .14); }
  :not(pre) > code { padding: .12em .4em; border-radius: .25em; color: #a8402a; background: rgba(179, 75, 53, .08); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .88em; }
  ::selection { color: #fffaf2; background: #b34b35; }
  .motion-ready [data-reveal] { opacity: 0; transform: translateY(18px); transition: opacity .6s ease var(--delay, 0ms), transform .6s cubic-bezier(.2, .8, .2, 1) var(--delay, 0ms); }
  .motion-ready [data-reveal].is-visible { opacity: 1; transform: translateY(0); }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; } .scroll-progress { display: none; } }
</style>
